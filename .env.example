# ============================================
# Moha Weaves Environment Configuration
# ============================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/moha_weaves"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_UxXBzl98ySixq7"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# 🆕 Delhivery Shipping Configuration
DELHIVERY_API_TOKEN="your_delhivery_api_token"
DELHIVERY_CLIENT_ID="your_delhivery_client_id"
DELHIVERY_PRODUCTION_URL="https://track.delhivery.com"
DELHIVERY_TEST_URL="https://test.delhivery.com"

# 🆕 Automatic Shipping Configuration
ENABLE_AUTO_SHIPPING=true
AUTO_SHIPPING_THRESHOLD=10000
DEFAULT_SHIPPING_METHOD=delhivery
FALLBACK_COURIERS="blue-dart,xpressbees,fedex"

# 🆕 Webhook Configuration
DELHIVERY_WEBHOOK_SECRET="your_webhook_secret"
WEBHOOK_BASE_URL="https://your-domain.com"

# 🆕 Notification Services
SMS_SERVICE_PROVIDER="twilio" # twilio, messagebird, etc.
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

EMAIL_SERVICE_PROVIDER="sendgrid" # sendgrid, ses, etc.
SENDGRID_API_KEY="your_sendgrid_api_key"
FROM_EMAIL="noreply@mohaweaves.com"
FROM_NAME="Moha Weaves"

# 🆕 Address Validation
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# 🆕 Cache Configuration
REDIS_URL="redis://localhost:6379"

# 🆕 File Upload
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="moha-weaves-uploads"

# 🆕 Analytics
GOOGLE_ANALYTICS_ID="GA-XXXXXXXXX"

# Development/Production
NODE_ENV="development"
PORT=5000

# CORS
FRONTEND_URL="http://localhost:3000"

# JWT Secret
JWT_SECRET="your_jwt_secret_key"

# Session
SESSION_SECRET="your_session_secret"
